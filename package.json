{
  "name": "@local/dsh-notch-pet",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "An animated companion that shows live DSH agent progress in the macOS notch.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "native/DSHNotchPet.app/**/*",
    "native/Sources/**/*",
    "native/Info.plist",
    "native/build.sh",
    "README.md",
    "scripts/peek.py",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
